# ===================================================
# StationAI — Environment Variables Reference
# ===================================================
# Copy this file to .env for local development.
# For Vercel production, add these in the Vercel Dashboard →
# Project → Settings → Environment Variables.
# ===================================================

# ---- BACKEND (server-side only, never expose via VITE_) ----

# Server port (only used for local dev; Vercel ignores this)
PORT=5000

# Set to "production" on Vercel
NODE_ENV=production

# JWT signing secret — CHANGE THIS for production!
JWT_SECRET=stationai_super_secret_jwt_key_2026_CHANGE_THIS

# OPTIONAL: PostgreSQL connection string for persistent production storage.
# If left empty, SQLite is used (data is ephemeral on Vercel's /tmp filesystem).
# Recommended providers: Neon (neon.tech), Supabase, Vercel Postgres.
# Example: postgres://username:password@ep-host.aws.neon.tech/stationai?sslmode=require
DATABASE_URL=

# CORS allowed origins (comma-separated). Set to * to allow all.
# In production on Vercel, same-origin requests don't need CORS.
CORS_ORIGIN=*

# ---- FRONTEND (safe to expose via VITE_ prefix) ----

# API base URL.
# • Local dev with Vite proxy: /api (Vite forwards /api → localhost:5000)
# • Vercel production: /api (same host, no change needed)
VITE_API_URL=/api
